  "about": {
    "title": "Vikas Kumar",
    "paragraphsHtml": [
      "👋 Hi! I am a PhD student in the <a href=\"https://eecs.iiserb.ac.in/\" target=\"_blank\" rel=\"noopener noreferrer\">Department of Electrical Engineering and Computer Science</a> at <a href=\"https://www.iiserb.ac.in/\" target=\"_blank\" rel=\"noopener noreferrer\">IISER Bhopal</a>, where I work in the <a href=\"https://sirl-lab.github.io/\" target=\"_blank\" rel=\"noopener noreferrer\">SIRL Lab</a>. My research focuses on intelligent systems and applied machine learning."
    ]
